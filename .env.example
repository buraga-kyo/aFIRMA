# Copie para .env e preencha os valores do seu provedor OAuth.
# Não use aspas: Spring lê este arquivo como propriedades.
APP_JWT_ISSUER_URI=https://SEU-EMISSOR
APP_JWT_AUDIENCE=SEU-PUBLICO

# Gere uma chave com: openssl rand -hex 32
# Informe a chave original na tela. A aplicação valida seu resumo SHA-256.
APP_API_KEY=CHAVE_ORIGINAL_PARA_USAR_NA_TELA
APP_API_KEY_SHA256=SHA256_DA_CHAVE
APP_CHAT_BRIDGE_KEY=COLOQUE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
APP_CHAT_BRIDGE_URL=http://127.0.0.1:8091
APP_CHAT_BACKEND_URL=http://127.0.0.1:8080
APP_CHAT_BRIDGE_PORT=8091
# Configuração opcional do transporte Chatwoot. A interface /chat é nativa.
# APP_CHATWOOT_API_URL=http://127.0.0.1:3100
# APP_CHATWOOT_INBOX_ID=IDENTIFICADOR_DA_CAIXA_API
# APP_CHATWOOT_INBOX_NUMERO=1
# APP_CHATWOOT_CANAL_ID=UUID_DO_CANAL_DA_FIRMA
# APP_CHATWOOT_WEBHOOK_SECRET=SEGREDO_DA_CAIXA_API

# Canal oficial: defina a versão, o segredo do aplicativo e o token de verificação.
# A referência APP_META_TOKEN_<NOME> é informada no cadastro do canal.
# APP_META_VERSAO=v23.0
# APP_META_APP_SECRET=SEGREDO_DO_APLICATIVO_COM_32_CARACTERES_OU_MAIS
# APP_META_WEBHOOK_TOKEN=TOKEN_DE_VERIFICACAO_COM_32_CARACTERES_OU_MAIS
# APP_META_TOKEN_PRINCIPAL=TOKEN_DE_ACESSO_DO_CANAL

# Webhooks e agentes usam somente referências a segredos do ambiente.
# APP_CHAT_WEBHOOK_PRINCIPAL=SEGREDO_ALEATORIO_COM_32_CARACTERES_OU_MAIS
# APP_IA_TOKEN_PRINCIPAL=TOKEN_DO_PROVEDOR


# Apenas para testes com certificado vencido. Mantenha false no uso normal.
APP_PERMITIR_CERTIFICADO_VENCIDO=false

# Consulta de transações e blocos finalizados na Sepolia.
APP_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=SENHA_FORTE_DO_POSTGRES
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mydatabase
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=SENHA_FORTE_DO_POSTGRES
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# AssineAi: PDFs no MinIO (novos documentos; registros antigos seguem legíveis).
MINIO_ROOT_USER=afirma-local
MINIO_ROOT_PASSWORD=TROQUE_ESTA_SENHA
ASSINEAI_MINIO_ENDPOINT=http://127.0.0.1:9000
ASSINEAI_MINIO_ACCESS_KEY=afirma-local
ASSINEAI_MINIO_SECRET_KEY=TROQUE_ESTA_SENHA
ASSINEAI_MINIO_BUCKET=afirma-documentos

# Plano de busca com GPT. A chave nunca vai para o navegador.
# ASSINEAI_GPT_API_KEY=COLOQUE_SUA_CHAVE
# ASSINEAI_GPT_MODEL=gpt-4o-mini

# Gateway de entrega do wizard (opcional). Sem URL, códigos e notificações ficam indisponíveis.
# POST JSON: {canal: email|whatsapp, destino, tipo: codigo|convite, conteudo}.
APP_ASSINATURAS_ENTREGA_URL=
APP_ASSINATURAS_ENTREGA_SEGREDO=

# Compatibilidade com a estrutura de produção do Assineai.
# Use o mesmo JWT_SECRET antigo para preservar sessões de Empresa existentes.
APP_ASSINEAI_JWT_SECRET=
# Empresa dona dos registros antigos que não possuem vínculo de proprietário.
APP_ASSINEAI_EMPRESA_LEGADA_ID=0
# Ative somente para clientes antigos que não enviavam Authorization.
# Aplica-se às rotas antigas, não à API /api/assineai. Exige EMPRESA_LEGADA_ID.
APP_ASSINEAI_COMPATIBILIDADE_PUBLICA=false
# Certificado para certificar cada PDF automaticamente, como no fluxo antigo.
# Sem estes valores, o proprietário pode fornecer PFX/P12 pela tela de histórico.
APP_ASSINEAI_CERTIFICADO_PATH=
APP_ASSINEAI_CERTIFICADO_SENHA=

# TalkAtive: gratuito, sem contratação ou quotas de plano.
# As rotinas usam somente canais e integrações configurados pela própria instalação.
APP_FIRMA_ROTINAS=true
APP_FIREBASE_ATIVO=false
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/credencial-propria-firebase.json
# FIREBASE_PROJECT_ID=seu-projeto
# Recuperação de senha dos usuários do TalkAtive:
# SPRING_MAIL_HOST=smtp.seu-dominio
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=usuario-smtp
# SPRING_MAIL_PASSWORD=senha-smtp
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# APP_EMAIL_FROM=atendimento@seu-dominio
# Bases das integrações (use as credenciais da sua própria empresa no cadastro):
# SGA_BASE_URL=https://api-do-seu-sga
# ASAAS_BASE_URL=https://api-do-seu-asaas
# HCONTROL_BASE_URL=https://api-do-seu-hcontrol

# Identidade assinada no motor de chat e renovação de fotos.
APP_CHATWOOT_HMAC_TOKEN=
APP_FIRMA_FOTOS_INTERVALO_MS=60000

# Conector externo opcional DocuSeal Pro. A bancada Java funciona sem estas variáveis.
APP_DOCUSEAL_URL=
APP_DOCUSEAL_API_KEY=

# Revisão da assinatura digital
# APP_CHATWOOT_URL=http://127.0.0.1:3100/
# ASSINEAI_RAIZES_CONFIAVEIS_PEM=/caminho/autoridades-confiaveis.pem
# ASSINEAI_OCSP_URL=https://ocsp.sua-autoridade.example
# ASSINEAI_TSA_URL=https://tsa.sua-autoridade.example
# ASSINEAI_TSA_RAIZES_PEM=/caminho/autoridades-carimbo.pem
# ASSINEAI_SEGREDO_EVIDENCIAS=SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
# ASSINEAI_URL_PUBLICA=https://assinaturas.suaempresa.example
# ASSINEAI_CONTROLADOR_NOME='Sua empresa'
# ASSINEAI_CONTROLADOR_CONTATO=privacidade@suaempresa.example
# ASSINEAI_BASE_TRATAMENTO_DADOS='Fundamento avaliado pelo responsável para as finalidades da instalação'
ASSINEAI_RETENCAO_EVIDENCIAS_DIAS=1825
# ASSINEAI_SMTP_HOST=smtp.gmail.com
# ASSINEAI_SMTP_PORT=587
# ASSINEAI_SMTP_USUARIO=usuario
# ASSINEAI_SMTP_SENHA=SENHA_DE_APP_SEM_ESPACOS
# ASSINEAI_EMAIL_REMETENTE=assinaturas@suaempresa.example
# ASSINEAI_SMTP_AUTENTICAR=false
# ASSINEAI_SMTP_STARTTLS=false
# ASSINEAI_CHAVES_EVIDENCIAS='{"principal":"SEGREDO_ANTIGO_COM_PELO_MENOS_32_CARACTERES","nova":"SEGREDO_NOVO_COM_PELO_MENOS_32_CARACTERES"}'
# ASSINEAI_CHAVE_ATIVA=nova
ASSINEAI_PERMITIR_FOTOGRAFIA=false
# ASSINEAI_FINALIDADE_FOTOGRAFIA='Finalidade avaliada para a inclusão da imagem no PDF e nas provas'
APP_ASSINATURA_BLOCKCHAIN_EXPERIMENTAL=false
# SPRING_FLYWAY_ENABLED=false
# ASSINEAI_CERTIFICADO_SENHA=SENHA_DO_PFX

# Duração da conexão compartilhada entre telas, sem prolongar a validade do JWT externo.
APP_SESSAO_ACESSO_MINUTOS=30

# Empresa autorizada a usar o PFX do servidor. O ID é exibido no cadastro da empresa.
# A opção automática só pode ser ativada após configurar caminho, senha e este vínculo.
APP_ASSINEAI_CERTIFICADO_EMPRESA_ID=0

# Cofre dos certificados enviados pela tela da empresa. Gere com: openssl rand -base64 32
# Preserve esta chave junto dos backups; ela não fica no banco nem no Git.
# APP_CHAVE_COFRE_CERTIFICADOS=BASE64_DE_32_BYTES_ALEATORIOS

# IPs ou redes dos proxies que podem encaminhar X-Forwarded-For. Vazio no acesso direto.
APP_PROXIES_CONFIAVEIS=
