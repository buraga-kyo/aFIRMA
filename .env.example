# Copie para .env e preencha os valores do seu provedor OAuth.
# Não use aspas: Spring lê este arquivo como propriedades.
APP_JWT_ISSUER_URI=https://SEU-EMISSOR
APP_JWT_AUDIENCE=SEU-PUBLICO

# Gere uma chave com: openssl rand -hex 32
# Informe a chave original na tela. A aplicação valida seu resumo SHA-256.
APP_API_KEY=CHAVE_ORIGINAL_PARA_USAR_NA_TELA
APP_API_KEY_SHA256=SHA256_DA_CHAVE
APP_CHAT_BRIDGE_KEY=COLOQUE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
APP_CHAT_BRIDGE_URL=http://127.0.0.1:8091
APP_CHAT_BACKEND_URL=http://127.0.0.1:8080
APP_CHAT_BRIDGE_PORT=8091
# Central TalkAtive dentro de /chat. Deixe vazio para usar a interface anterior.
# APP_CHATWOOT_URL=http://127.0.0.1:3100/
# APP_CHATWOOT_API_URL=http://127.0.0.1:3100
# APP_CHATWOOT_INBOX_ID=IDENTIFICADOR_DA_CAIXA_API
# APP_CHATWOOT_INBOX_NUMERO=1
# APP_CHATWOOT_CANAL_ID=UUID_DO_CANAL_DA_FIRMA
# APP_CHATWOOT_WEBHOOK_SECRET=SEGREDO_DA_CAIXA_API

# Canal oficial: defina a versão, o segredo do aplicativo e o token de verificação.
# A referência APP_META_TOKEN_<NOME> é informada no cadastro do canal.
# APP_META_VERSAO=v23.0
# APP_META_APP_SECRET=SEGREDO_DO_APLICATIVO_COM_32_CARACTERES_OU_MAIS
# APP_META_WEBHOOK_TOKEN=TOKEN_DE_VERIFICACAO_COM_32_CARACTERES_OU_MAIS
# APP_META_TOKEN_PRINCIPAL=TOKEN_DE_ACESSO_DO_CANAL

# Webhooks e agentes usam somente referências a segredos do ambiente.
# APP_CHAT_WEBHOOK_PRINCIPAL=SEGREDO_ALEATORIO_COM_32_CARACTERES_OU_MAIS
# APP_IA_TOKEN_PRINCIPAL=TOKEN_DO_PROVEDOR


# Apenas para testes com certificado vencido. Mantenha false no uso normal.
APP_PERMITIR_CERTIFICADO_VENCIDO=false

# Consulta de transações e blocos finalizados na Sepolia.
APP_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=SENHA_FORTE_DO_POSTGRES
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mydatabase
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=SENHA_FORTE_DO_POSTGRES
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# AssineAi: PDFs no MinIO (novos documentos; registros antigos seguem legíveis).
MINIO_ROOT_USER=afirma-local
MINIO_ROOT_PASSWORD=TROQUE_ESTA_SENHA
ASSINEAI_MINIO_ENDPOINT=http://127.0.0.1:9000
ASSINEAI_MINIO_ACCESS_KEY=afirma-local
ASSINEAI_MINIO_SECRET_KEY=TROQUE_ESTA_SENHA
ASSINEAI_MINIO_BUCKET=afirma-documentos

# Plano de busca com GPT. A chave nunca vai para o navegador.
# ASSINEAI_GPT_API_KEY=COLOQUE_SUA_CHAVE
# ASSINEAI_GPT_MODEL=gpt-4o-mini
